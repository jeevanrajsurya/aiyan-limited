# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sandb_retail?schema=public"

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Email (Nodemailer/SMTP - e.g. SendGrid, Mailtrap)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="S&B Retail <no-reply@sandbretailltd.com>"

# File storage (local uploads dir by default; swap for S3/Cloudinary later)
UPLOAD_DIR=uploads
